# Trillion AI Tech — Environment Variables
#
# IMPORTANT: Never commit real credentials. This file contains placeholders only.
# Copy this file to .env and fill in your actual values.

# Supabase Configuration (Authentication & Database)
# Get these from your Supabase project settings: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# IMPORTANT: Never commit your Supabase service-role key to the repository.
# SUPABASE_SERVICE_ROLE_KEY should only be used in server-side code or edge functions.

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://trillionaitech.com
NEXT_PUBLIC_SITE_NAME=Trillion AI Tech

# Email Configuration (for future transactional emails)
# These would be used in server-side functions, not client-side
# EMAIL_FROM=noreply@trillionaitech.com
# EMAIL_REPLY_TO=hello@trillionaitech.com

# Marketing/Newsletter Provider (future)
# MAILCHIMP_API_KEY=
# MAILCHIMP_AUDIENCE_ID=

# Stripe Configuration (future - for individual product payments)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
